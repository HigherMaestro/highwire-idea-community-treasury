{
  "name": "community-treasury",
  "private": true,
  "type": "module",
  "description": "An agent that launches a coin whose creator fees fill a treasury, claims them every day, posts the books on the coin's page, and drafts payouts to wallets you chose, which you approve.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/start.ts",
    "service": "node scripts/service.mjs",
    "setup": "node scripts/setup.mjs",
    "highwire": "node scripts/highwire.mjs",
    "orders": "node scripts/highwire.mjs orders run",
    "agent": "tsx src/agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "highwire-agent": "0.14.2",
    "highwire-core": "0.14.2",
    "highwire-mcp": "0.14.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
